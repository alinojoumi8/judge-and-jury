# Copy this file to .env and fill in your MiniMax token-plan key.
# (PowerShell:  copy .env.example .env )

# Required: your MiniMax API key (token plan).
MINIMAX_API_KEY=your-key-here

# OpenAI-compatible base URL for MiniMax.
#   International: https://api.minimax.io/v1
#   China:        https://api.minimaxi.chat/v1
MINIMAX_BASE_URL=https://api.minimax.io/v1

# Model id to use. Set this to whatever your token plan exposes, e.g.:
#   MiniMax-M2.1 , MiniMax-M2.1-lightning , MiniMax-M2 , MiniMax-Text-01
MINIMAX_MODEL=MiniMax-M2.1

# Optional. Ceiling on simultaneous model calls. Deliberation fans out one call
# per juror per sample (12 jurors x 5 passes = 60 at once); a ceiling keeps that
# burst under your plan's rate limit so no juror's ballot is lost to a 429.
# LLM_MAX_CONCURRENCY=8

# Optional. Seconds to wait before retrying a failed model call (doubles each
# attempt; two retries).
# LLM_RETRY_BACKOFF=1.5
